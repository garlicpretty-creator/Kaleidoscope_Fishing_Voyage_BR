{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "kaleidoscope_fishing:ender_fishing_rod",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/kfv_ender_rod",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_fishing.bamboo_rod"
      },
      "animations": {
        "hold_first_person": "animation.kaleidoscope_fishing.bamboo_rod.hold_first_person",
        "hold_third_person": "animation.kaleidoscope_fishing.bamboo_rod.hold_third_person",
        "reel_first_person": "animation.kaleidoscope_fishing.bamboo_rod.reel_first_person",
        "reel_third_person": "animation.kaleidoscope_fishing.bamboo_rod.reel_third_person"
      },
      "scripts": {
        "animate": [
          {
            "hold_first_person": "c.is_first_person"
          },
          {
            "hold_third_person": "!c.is_first_person"
          },
          {
            "reel_first_person": "c.is_first_person && q.main_hand_item_use_duration > 0.0"
          },
          {
            "reel_third_person": "!c.is_first_person && q.main_hand_item_use_duration > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}
