        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": [
              0.95,
              0.88,
              0.72,
              0.0
            ],
            "0.2": [
              0.95,
              0.88,
              0.72,
              0.2
            ],
            "0.55": [
              0.95,
              0.88,
              0.72,
              0.2
            ],
            "1.0": [
              0.95,
              0.88,
              0.72,
              0.0
            ]
          }
        }
      }
