          1,
          "math.random(-0.2, 0.2)"
        ]
      },
      "minecraft:particle_initial_speed": "math.random(0.08, 0.16)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.8, 2.6)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 200 + variable.particle_random_1 * 360) * 0.12",
