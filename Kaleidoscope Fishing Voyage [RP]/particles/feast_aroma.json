{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "kaleidoscope_fishing:feast_aroma",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "direction": ["math.random(-0.15, 0.15)", 1, "math.random(-0.15, 0.15)"]
      },
      "minecraft:particle_initial_speed": "math.random(0.35, 0.6)",
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["math.sin(variable.particle_age * 180) * 0.15", 0.12, 0],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.08 + variable.particle_age / variable.particle_lifetime * 0.16", "0.08 + variable.particle_age / variable.particle_lifetime * 0.16"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "flipbook": {
            "base_UV": [56, 0],
            "size_UV": [8, 8],
            "step_UV": [-8, 0],
            "frames_per_second": 4,
            "max_frame": 8,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": [1.0, 0.95, 0.82, 0.0],
            "0.15": [1.0, 0.93, 0.78, 0.75],
            "1.0": [1.0, 0.9, 0.75, 0.0]
          }
        }
      }
    }
  }
}
