{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "kaleidoscope_fishing:fish_merchant",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/kfv_fish_merchant",
        "w1": "textures/items/kfv_carp",
        "w2": "textures/items/kfv_grass_carp",
