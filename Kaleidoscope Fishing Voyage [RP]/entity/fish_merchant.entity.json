        "w13": "textures/items/kfv_rainbow_trout",
        "w14": "textures/items/kfv_octopus",
        "w15": "textures/items/kfv_grouper",
        "w16": "textures/items/kfv_arctic_char",
        "w17": "textures/items/kfv_tuna",
        "w18": "textures/items/kfv_anglerfish",
        "w19": "textures/items/kfv_void_eel",
        "w20": "textures/items/kfv_starfin",
        "w21": "textures/items/kfv_blazefin",
        "w22": "textures/items/kfv_lava_eel",
        "w23": "textures/items/kfv_magma_koi",
        "w24": "textures/items/kfv_golden_croaker",
        "w25": "textures/items/kfv_moon_jellyfish",
        "w26": "textures/items/kfv_glow_crab",
        "w27": "textures/items/kfv_chorus_carp",
        "w28": "textures/items/kfv_chorus_jellyfish",
        "w29": "textures/items/kfv_ender_angler",
        "w30": "textures/items/kfv_sea_bass",
        "w31": "textures/items/kfv_grey_mullet",
        "w32": "textures/items/kfv_snakehead",
        "w33": "textures/items/kfv_flying_fish",
        "w34": "textures/items/kfv_lobster",
        "w35": "textures/items/kfv_king_crab",
        "w36": "textures/items/kfv_cave_blindfish"
      },
      "geometry": {
        "default": "geometry.kaleidoscope_fishing.fish_merchant",
        "wants": "geometry.kaleidoscope_fishing.fish_merchant_wants"
      },
      "animations": {
        "move": "animation.kaleidoscope_fishing.fish_merchant.move",
        "look_at_target": "animation.common.look_at_target",
        "gesture": "animation.kaleidoscope_fishing.fish_merchant.gesture"
      },
      "scripts": {
        "animate": [
          "move",
          "gesture",
          "look_at_target"
        ],
        "initialize": [
          "variable.kfv_off = math.random(0, 12);"
        ],
        "pre_animation": [
          "variable.kfv_gt = query.property('kaleidoscope_fishing:gesture') > 0 ? variable.kfv_gt + math.min(query.delta_time, 0.1) : 0;",
          "variable.kfv_bow = (query.property('kaleidoscope_fishing:gesture') == 1) * math.sin(math.clamp(variable.kfv_gt / 1.2, 0, 1) * 180);",
          "variable.kfv_no = (query.property('kaleidoscope_fishing:gesture') == 2) * math.clamp(variable.kfv_gt / 0.1, 0, 1) * math.clamp(1 - variable.kfv_gt / 1.0, 0, 1);",
          "variable.kfv_idle = math.clamp(1 - query.modified_move_speed * 4, 0, 1);",
          "variable.kfv_it = math.mod(query.life_time + variable.kfv_off, 12);",
          "variable.kfv_call = variable.kfv_idle * math.clamp((variable.kfv_it - 6) / 0.35, 0, 1) * math.clamp((8.2 - variable.kfv_it) / 0.4, 0, 1);",
          "variable.kfv_nod = variable.kfv_idle * (variable.kfv_it >= 9 && variable.kfv_it < 9.9) * math.abs(math.sin((variable.kfv_it - 9) * 400));",
          "variable.kfv_lean = variable.kfv_bow * 12 - 3 * variable.kfv_call;"
        ]
      },
      "render_controllers": [
        "controller.render.default",
        {
          "controller.render.kfv_merchant_want_a": "query.property('kaleidoscope_fishing:want_a') > 0"
        },
        {
          "controller.render.kfv_merchant_want_b": "query.property('kaleidoscope_fishing:want_b') > 0"
        },
        {
          "controller.render.kfv_merchant_order": "query.property('kaleidoscope_fishing:order') > 0"
        }
      ],
      "spawn_egg": {
        "texture": "kfv_spawn_egg_fish_merchant"
      }
    }
  }
}