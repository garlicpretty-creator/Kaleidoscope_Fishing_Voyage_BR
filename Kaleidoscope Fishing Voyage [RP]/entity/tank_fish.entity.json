      "scripts": {
        "pre_animation": [
          "v.kind = q.property('kaleidoscope_fishing:kind');",
          "v.seed = q.property('kaleidoscope_fishing:seed');",
          "v.sc = q.property('kaleidoscope_fishing:scale') / 100;",
          "v.span = q.property('kaleidoscope_fishing:span') / 10;",
          "v.yb = q.property('kaleidoscope_fishing:level') / 10;",
          "v.lane = q.property('kaleidoscope_fishing:lane') / 10 - 6;",
          "v.ph = v.seed * 83 + q.property('kaleidoscope_fishing:species') * 37;",
          "v.speed = (v.kind == 3 ? 0.65 : (v.kind == 6 ? 0.75 : 1)) * (3.2 + v.seed * 0.25) * (q.property('kaleidoscope_fishing:tank') ? 1.3 : 1) * 57.3 / math.max(v.span, 1.2);",
          "v.tt = q.life_time * v.speed + v.ph;",
          "v.dir = math.clamp(math.cos(v.tt) * 3, -1, 1);"
        ],
        "animate": [
          {
            "swim": "v.kind == 0 || v.kind == 1 || v.kind == 3 || v.kind == 6"
          },
          {
            "drift": "v.kind == 2 || v.kind == 4"
          },
          {
            "walk": "v.kind == 5"
          }
        ]
      },
