{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.kfv_tide_clock": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "part_visibility": [
        {
          "*": true
        },
        {
          "moon_l2": "q.moon_phase <= 3"
        },
        {
          "moon_l1": "q.moon_phase <= 2 || q.moon_phase == 7"
        },
        {
          "moon_r1": "q.moon_phase <= 1 || q.moon_phase >= 6"
        },
        {
          "moon_r2": "q.moon_phase == 0 || q.moon_phase >= 5"
        }
      ]
    }
  }
}
