{
  "format_version": "1.8.0",
  "animations": {
    "animation.kaleidoscope_fishing.fish_merchant.move": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(query.life_time * 20) * 0.6",
            "math.sin(query.modified_distance_moved * 38.17) * 2.5 * query.modified_move_speed",
            "math.sin(query.modified_distance_moved * 38.17) * 1.2 * query.modified_move_speed"
          ],
          "position": [
            0,
            "-math.abs(math.cos(query.modified_distance_moved * 38.17)) * 0.6 * query.modified_move_speed",
            0
          ]
        },
        "head": {
          "rotation": [
            "math.sin(query.life_time * 20 + 40) * 1.2 + math.abs(math.cos(query.modified_distance_moved * 38.17)) * 3 * query.modified_move_speed",
            0,
            "-math.sin(query.modified_distance_moved * 38.17) * 1.5 * query.modified_move_speed"
          ]
        },
        "arms": {
          "rotation": [
            "math.sin(query.life_time * 20) * 0.8 + math.abs(math.cos(query.modified_distance_moved * 38.17)) * 2.5 * query.modified_move_speed",
            "-math.sin(query.modified_distance_moved * 38.17) * 2 * query.modified_move_speed",
            0
          ]
        },
        "leg_r": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 40 * query.modified_move_speed",
            0,
            0
          ]
        },
        "leg_l": {
          "rotation": [
            "-math.cos(query.modified_distance_moved * 38.17) * 40 * query.modified_move_speed",
            0,
            0
          ]
        },
        "pole": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38.17) * 2.5 * query.modified_move_speed",
            0,
            "math.sin(query.modified_distance_moved * 19.08) * 1.5 * query.modified_move_speed"
          ]
        },
        "basket_f": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 38.17 - 40) * 8 * query.modified_move_speed + math.sin(query.life_time * 90) * 1.2",
            0,
            "math.sin(query.modified_distance_moved * 19.08 + 30) * 5 * query.modified_move_speed"
          ]
        },
        "basket_b": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 38.17 - 40) * 8 * query.modified_move_speed + math.sin(query.life_time * 90 + 60) * 1.2",
            0,
            "math.sin(query.modified_distance_moved * 19.08 - 30) * 5 * query.modified_move_speed"
          ]
        }
      }
    },
    "animation.kaleidoscope_fishing.fish_merchant.gesture": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "variable.kfv_lean",
            0,
            0
          ],
          "position": [
            0,
            "-12 * (1 - math.cos(variable.kfv_lean))",
            "-12 * math.sin(variable.kfv_lean)"
          ]
        },
        "head": {
          "rotation": [
            "15 * variable.kfv_bow - 14 * variable.kfv_call + math.sin(query.life_time * 500) * 3 * variable.kfv_call + 9 * variable.kfv_nod",
            "math.sin(variable.kfv_gt * 900) * 22 * variable.kfv_no + math.sin((variable.kfv_it - 6) * 50) * 18 * variable.kfv_call",
            0
          ]
        },
        "arms": {
          "rotation": [
            "-22 * variable.kfv_call - 6 * variable.kfv_bow",
            0,
            0
          ]
        },
        "pole": {
          "rotation": [
            0,
            0,
            "math.sin(query.life_time * 120) * 1.5 * variable.kfv_call"
          ]
        },
        "basket_f": {
          "rotation": [
            "-variable.kfv_lean + math.sin(query.life_time * 55 + 20) * 3 + math.sin(variable.kfv_gt * 400) * 6 * variable.kfv_bow",
            0,
            "math.sin(query.life_time * 41) * 2"
          ]
        },
        "basket_b": {
          "rotation": [
            "-variable.kfv_lean + math.sin(query.life_time * 55 + 80) * 3 + math.sin(variable.kfv_gt * 400) * 6 * variable.kfv_bow",
            0,
            "math.sin(query.life_time * 41 + 50) * 2"
          ]
        }
      }
    }
  }
}