{
  "format_version": "1.8.0",
  "animations": {
    "animation.kaleidoscope_fishing.heron.move": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "math.sin(query.modified_distance_moved * 38) * 2 * query.modified_move_speed + (1 - query.is_on_ground) * -8",
            0,
            "math.sin(query.modified_distance_moved * 19) * 3 * query.modified_move_speed"
          ],
          "position": [
            0,
            "math.abs(math.cos(query.modified_distance_moved * 38)) * 0.5 * query.modified_move_speed + (1 - query.is_on_ground) * math.sin(query.life_time * 600 + 90) * 0.6",
            0
          ]
        },
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38) * 30 * query.modified_move_speed + (1 - query.is_on_ground) * 75",
            0,
            0
          ]
        },
        "leg_r": {
          "rotation": [
            "-(math.cos(query.modified_distance_moved * 38) * 30 * query.modified_move_speed) + (1 - query.is_on_ground) * 75",
            0,
            0
          ]
        },
        "neck": {
          "rotation": [
            "math.sin(query.life_time * 50) * 3 + math.sin(query.modified_distance_moved * 76) * 9 * query.modified_move_speed + query.property('kaleidoscope_fishing:pecking') * 60 + (1 - query.is_on_ground) * 25",
            "math.sin(query.life_time * 21) * 10 * math.max(0, 1 - query.modified_move_speed * 3) * query.is_on_ground",
            0
          ]
        },
        "neck_upper": {
          "rotation": [
            "-math.sin(query.modified_distance_moved * 76) * 7 * query.modified_move_speed - (1 - query.is_on_ground) * 20",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "query.property('kaleidoscope_fishing:pecking') * 15 + math.sin(query.modified_distance_moved * 76 + 40) * 5 * query.modified_move_speed",
            "math.sin(query.life_time * 33) * math.sin(query.life_time * 9) * 25 * math.max(0, 1 - query.modified_move_speed * 3) * query.is_on_ground",
            0
          ]
        },
        "tail": {
          "rotation": [
            "math.sin(query.life_time * 45) * 3 + math.sin(query.modified_distance_moved * 38) * 4 * query.modified_move_speed - (1 - query.is_on_ground) * 10",
            0,
            0
          ]
        },
        "wing_l": {
          "rotation": [
            0,
            0,
            "(1 - query.is_on_ground) * (math.sin(query.life_time * 600) * 35 + 25) + math.sin(query.modified_distance_moved * 19) * 3 * query.modified_move_speed"
          ]
        },
        "wing_r": {
          "rotation": [
            0,
            0,
            "-((1 - query.is_on_ground) * (math.sin(query.life_time * 600) * 35 + 25)) - math.sin(query.modified_distance_moved * 19) * 3 * query.modified_move_speed"
          ]
        }
      }
    }
  }
}