{
  "format_version": "1.8.0",
  "animations": {
    "animation.kaleidoscope_fishing.heron.move": {
      "loop": true,
      "bones": {
        "leg_l": {
          "rotation": [
            "math.cos(query.modified_distance_moved * 38) * 30 * query.modified_move_speed + (1 - query.is_on_ground) * 75",
            0,
            0
          ]
        },
        "leg_r": {
          "rotation": [
            "-(math.cos(query.modified_distance_moved * 38) * 30 * query.modified_move_speed) + (1 - query.is_on_ground) * 75",
            0,
            0
          ]
        },
        "neck": {
          "rotation": [
            "math.sin(query.life_time * 50) * 3 + query.property('kaleidoscope_fishing:pecking') * 60",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "query.property('kaleidoscope_fishing:pecking') * 15",
            0,
            0
          ]
        },
        "wing_l": {
          "rotation": [
            0,
            0,
            "(1 - query.is_on_ground) * (math.sin(query.life_time * 600) * 35 + 25)"
          ]
        },
        "wing_r": {
          "rotation": [
            0,
            0,
            "-((1 - query.is_on_ground) * (math.sin(query.life_time * 600) * 35 + 25))"
          ]
        }
      }
    }
  }
}
